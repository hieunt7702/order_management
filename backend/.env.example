PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://shopee_user:shopee_password@localhost:5432/shopee_order_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET="default_access_secret_key_change_me_in_production_12345678"
JWT_REFRESH_SECRET="default_refresh_secret_key_change_me_in_production_87654321"
JWT_ACCESS_EXPIRATION="900s"
JWT_REFRESH_EXPIRATION="7d"

# App Settings
DEFAULT_TIMEZONE="Asia/Ho_Chi_Minh"
CORS_ORIGIN="http://localhost:5173"
