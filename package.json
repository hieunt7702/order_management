{
  "name": "shopee-order-system",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n \"BE,FE\" -c \"blue.bold,magenta.bold\" --kill-others-on-fail \"pnpm --filter shopee-order-backend dev\" \"pnpm --filter shopee-order-frontend dev\"",
    "dev:parallel": "pnpm -r --parallel run dev",
    "dev:backend": "pnpm --filter shopee-order-backend dev",
    "dev:frontend": "pnpm --filter shopee-order-frontend dev",
    "build": "pnpm -r run build",
    "build:backend": "pnpm --filter shopee-order-backend build",
    "build:frontend": "pnpm --filter shopee-order-frontend build",
    "prisma:generate": "pnpm --filter shopee-order-backend prisma:generate",
    "prisma:migrate": "pnpm --filter shopee-order-backend prisma:migrate",
    "prisma:seed": "pnpm --filter shopee-order-backend prisma:seed",
    "prisma:seed:admin": "pnpm --filter shopee-order-backend prisma:seed:admin",
    "prisma:clear": "pnpm --filter shopee-order-backend prisma:clear",
    "start": "pnpm --filter shopee-order-backend start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
